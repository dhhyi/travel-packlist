    "@nx/eslint": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/playwright": "23.1.1",
    "@nx/plugin": "23.1.1",
    "@nx/storybook": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@playwright/test": "1.61.1",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-themes": "^10.5.5",
    "@storybook/angular": "^10.5.5",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.47",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/showdown": "^2.0.6",
    "@typescript-eslint/utils": "^8.65.0",
    "@vitest/eslint-plugin": "^1.6.24",
    "angular-eslint": "22.1.0",
    "autoprefixer": "^10.5.4",
    "conventional-changelog": "^8.1.0",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "cspell": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-storybook": "^10.5.5",
    "globals": "^17.8.0",
    "jsonc-eslint-parser": "^3.1.0",
    "markdownlint-cli": "^0.49.1",
    "minimatch": "^10.2.6",
    "nx-stylelint": "^19.0.0",
    "postcss": "^8.5.25",
    "storybook": "^10.5.5",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "24"
  },
  "license": "MIT",
  "name": "travel-packlist-root",
  "nx": {
    "implicitDependencies": [
      "check-plugin",
      "libs/*",
      "apps/*"
    ],
    "includedScripts": [
      "dev",
      "start"
    ],
    "targets": {
      "check-sync-playwright-version": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node util/check-sync-playwright-version.mjs"
        }
      },
      "create-prettierignore": {
        "cache": true,
        "executor": "nx:run-script",
        "inputs": [
          "{workspaceRoot}/util/create-prettierignore.mjs",
          "{workspaceRoot}/**/.gitignore"
        ],
        "options": {
          "script": "create-prettierignore"
        },
        "outputs": [
          "{workspaceRoot}/.prettierignore"
        ]
      },
      "dead-code": {
        "cache": false,
        "dependsOn": [
          "^dead-code"
        ],
        "executor": "@travel-packlist/check-plugin:dead-code-summary",
        "inputs": [
          "{workspaceRoot}/dist/**/dead-code/imports.json",
          "{workspaceRoot}/dist/**/dead-code/exports.json"
        ]
      },
      "design": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "nx storybook design-system",
            "nx run design-system:compile-styles:watch"
          ],
          "parallel": true
        }
      },
      "format": {
        "configurations": {
          "ci": {
            "command": "nx format:check --all"
          },
          "pre-commit": {
            "command": "nx format:write --uncommitted"
          }
        },
        "dependsOn": [
          "create-prettierignore"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "nx format:write --all"
        }
      },
      "lint": {
        "configurations": {
          "pre-commit": {
            "command": "eslint --max-warnings 0 *.{js,mjs,ts} util/*.mjs --fix"
          }
        },
        "dependsOn": [
          "check-sync-playwright-version"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "eslint --max-warnings 0 *.{js,mjs,ts} util/*.mjs"
        }
      },
      "markdownlint": {
        "executor": "@travel-packlist/check-plugin:markdown",
        "options": {
          "exclude": [
            "AGENTS.md",
            "CHANGELOG.md"
          ],
          "pattern": "*.md"
        }
      }
    }
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "lmdb",
      "msgpackr-extract"
    ],
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "nx",
      "sharp"
    ],
    "overrides": {
      "@hono/node-server@<2.0.5": ">=2.0.5",
      "adm-zip@<0.6.0": ">=0.6.0",
      "brace-expansion@<=5.0.7": ">=5.0.8",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@<3.1.4": ">=3.1.4",
      "postcss@<=8.5.17": ">=8.5.18",
      "sharp@<0.35.0": ">=0.35.0",
      "tar@<7.5.7": ">=7.5.7",
      "tar@<7.5.8": ">=7.5.8",
      "tar@<=7.5.10": ">=7.5.11",
      "tar@<=7.5.15": ">=7.5.16",
      "tar@<=7.5.16": ">=7.5.17",
      "tar@<=7.5.17": ">=7.5.18",
      "tar@<=7.5.18": ">=7.5.19",
      "tar@<=7.5.2": ">=7.5.3",
      "tar@<=7.5.20": ">=7.5.21",
      "tar@<=7.5.3": ">=7.5.4",
      "tar@<=7.5.9": ">=7.5.10",
      "undici@>=7.0.0 <7.28.0": ">=7.28.0",
      "undici@>=7.23.0 <7.28.0": ">=7.28.0",
      "uuid@<11.1.1": ">=11.1.1",
      "webpack-dev-server@<5.2.5": ">=5.2.5",
      "webpack-dev-server@<=5.2.3": ">=5.2.4",
      "webpack-dev-server@<=5.2.5": ">=5.2.6"
    }
  },
  "private": true,
  "scripts": {
    "changelog": "conventional-changelog -i CHANGELOG.md -n util/conventionalcommits.mjs",
    "create-prettierignore": "node util/create-prettierignore.mjs",
    "dev": "nx serve travel-packlist",
    "postversion": "git push && git push --tags",
    "prepare": "husky",
    "release-notes": "conventional-changelog -i null -r 2 --config util/conventionalcommits.mjs -o",
    "start": "nx serve travel-packlist-web",
    "version": "pnpm run changelog -s && git add CHANGELOG.md"
  },
  "version": "1.9.0"
}
