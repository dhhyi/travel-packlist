{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/refs/heads/main/schemas/devContainer.schema.json",
  "name": "travel-packlist",
  "runArgs": [
    "--name",
    "travel-packlist-${devcontainerId}"
  ],
  "mounts": [
    "type=volume,target=/home/vscode/.local/state/lazygit,source=lazygit-history-travel-packlist",
    "type=volume,target=${containerWorkspaceFolder}/node_modules,source=travel-packlist-node-modules",
    "type=volume,target=${containerWorkspaceFolder}/.pnpm-store,source=pnpm-store",
    "type=volume,target=/home/vscode/.cache/ms-playwright,source=playwright-cache",
    "type=volume,target=/home/vscode/.cache/mise,source=mise-cache"
  ],
  "postCreateCommand": "sudo install -d -o vscode -g vscode node_modules .pnpm-store /home/vscode /home/vscode/.cache /home/vscode/.cache/ms-playwright /home/vscode /home/vscode/.cache /home/vscode/.cache/mise && fish -c 'mise activate fish | source && mise install && if test -f package.json; pnpm install; end && if ! set -q CI; cd /tmp/git-diff-image && ./install.sh; end'",
  "build": {
    "dockerfile": "Dockerfile",
    "cacheFrom": "type=registry,ref=ghcr.io/dhhyi/travel-packlist-devcontainer-cache"
  },
  "forwardPorts": [
    4200,
    3100
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "chat.tools.terminal.terminalProfile.linux": {
          "path": "/usr/bin/bash"
        },
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "files.associations": {
          "**/whatsnew-*": "plaintext"
        },
        "files.exclude": {
          ".devcontainer": true,
          ".update_devcontainer.sh": true
        },
        "nxConsole.showProjectDetailsView": false,
        "tailwindCSS.classAttributes": [
          "class",
          "ngClass",
          "routerLinkActive",
          "animate.enter",
          "animate.leave"
        ],
        "tailwindCSS.includeLanguages": {
          "typescript": "css"
        },
        "terminal.integrated.automationProfile.linux": {
          "path": "/usr/bin/bash"
        },
        "terminal.integrated.defaultProfile.linux": "tmux-reuse",
        "terminal.integrated.profiles.linux": {
          "tmux-reuse": {
            "args": [
              "new-session",
              "-A",
              "-s",
              "vscode"
            ],
            "icon": "terminal-tmux",
            "path": "/usr/bin/tmux"
          }
        }
      },
      "extensions": [
        "angular.ng-template",
        "tomwhite007.rename-angular-component",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "streetsidesoftware.code-spell-checker",
        "bierner.markdown-preview-github-styles",
        "bierner.markdown-mermaid",
        "github.vscode-github-actions",
        "yzhang.markdown-all-in-one",
        "peggyjs.peggy-language",
        "nrwl.angular-console",
        "ms-playwright.playwright",
        "redhat.vscode-yaml",
        "aaron-bond.better-comments",
        "peakchen90.open-html-in-browser"
      ]
    }
  }
}
